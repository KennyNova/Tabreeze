# Chrome Web Store API credentials for `npm run publish:ext`.
# Copy to .env and fill in. Never commit .env.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# Publisher ID: Developer Dashboard > Account (shown on the account page)
CWS_PUBLISHER_ID=
# Extension (item) ID: the 32-letter ID in the store/dashboard URL
CWS_EXTENSION_ID=
